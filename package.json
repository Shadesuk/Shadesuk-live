{
  "name": "shadesuk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:run": "NODE_OPTIONS='--import ./scripts/register-server-only.mjs' npx --yes tsx",
    "verify:contracts": "npm run verify:run -- scripts/verify-data-contracts.ts",
    "verify:pdp": "npm run verify:run -- scripts/verify-pdp.ts",
    "verify:cart": "npm run verify:run -- scripts/verify-cart.ts",
    "verify:checkout": "npm run verify:run -- scripts/verify-checkout.ts",
    "verify:account": "npm run verify:run -- scripts/verify-account.ts",
    "verify:tracking": "npm run verify:run -- scripts/verify-tracking.ts",
    "verify:legal": "npm run verify:run -- scripts/verify-legal.ts",
    "verify:storefront": "npm run verify:run -- scripts/verify-storefront-catalogue.ts",
    "verify:search": "npm run verify:run -- scripts/verify-search.ts",
    "verify:catalogue": "npm run verify:run -- scripts/verify-catalogue.ts",
    "verify:collections": "npm run verify:run -- scripts/verify-collections.ts",
    "verify:discovery": "npm run verify:run -- scripts/verify-discovery.ts",
    "verify:admin-orders": "npm run verify:run -- scripts/verify-admin-orders.ts",
    "verify:admin": "npm run verify:run -- scripts/verify-admin-foundation.ts && npm run verify:run -- scripts/verify-admin-dashboard.ts && npm run verify:admin-orders",
    "verify:completion": "npm run verify:run -- scripts/verify-storefront-completion.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  }
}
