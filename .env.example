# Copy to .env.local and fill in real values. Never commit real values.

# Canonical site origin for metadataBase, sitemap, and robots.
# Required in Vercel (Production, Preview, and Development). Use the current
# Vercel deployment origin (https://<project>.vercel.app) until the canonical
# HTTPS domain is available. Do not leave this blank.
# Locally, if unset or empty, the app falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# The project has both key generations enabled: the modern publishable/secret
# pair and the legacy anon/service_role pair. Prefer the modern pair. The legacy
# names stay supported so an existing deployment keeps working.

# Project URL, e.g. https://<project-ref>.supabase.co
# Safe to expose to the browser. Must be https outside local development: the
# connection check refuses to send the secret key over plaintext http.
NEXT_PUBLIC_SUPABASE_URL=

# Public API key, safe to expose to the browser. Row level security is what
# protects your data with this key. Set the publishable key (sb_publishable_...)
# on projects that have the new API keys; otherwise set the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server-side only: bypasses row level security. Never prefix it with
# NEXT_PUBLIC_ and never import it from a Client Component. Set the secret key
# (sb_secret_...) on projects that have the new API keys; otherwise set the
# legacy service_role key.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# SECRET. HMAC for guest cart-lines and checkout-draft cookies. Bound to the
# httpOnly session id; the session id is never the HMAC key. Never NEXT_PUBLIC_.
# If unset, signing falls back to SUPABASE_SECRET_KEY (or SUPABASE_SERVICE_ROLE_KEY).
# Production fails closed if neither this nor a Supabase secret is set — there is
# no local HMAC fallback in NODE_ENV=production. Local `next dev` may use a
# development-only fallback.
GUEST_COOKIE_SECRET=

# --- Demo catalogue (development / preview only) ---
# Fixture products (Frame 01–06) are not live inventory.
# Ignored when VERCEL_ENV=production, or NODE_ENV=production outside Vercel preview.
# DEMO_CATALOGUE=true|1  → serve fixtures in `next dev` or Vercel preview
# DEMO_CATALOGUE=false|0 → never serve fixtures
# Unset: fixtures only when NODE_ENV=development AND live catalogue is
# unconfigured or the live fetch errors. Production with an empty published
# catalogue shows empty states; it does not fall back to demo.
# DEMO_CATALOGUE=

# --- Auth (no Google secrets in this app) ---
# Email/password and password reset use Supabase Auth with the keys above.
# Continue with Google is optional. Configure the Google provider in the
# Supabase dashboard (Authentication → Providers). Do not put Google OAuth
# client credentials in Next.js env. Redirect URL:
# {NEXT_PUBLIC_SITE_URL}/auth/callback
# See docs/PHASE3_ACCOUNT_AUTH.md.

# --- PayPal (server-only payment; hard cut from Razorpay) ---
# SECRET. Never prefix CLIENT_SECRET with NEXT_PUBLIC_.
# Never import CLIENT_SECRET from a Client Component.
# CLIENT_ID is the public JS SDK / REST app id and is returned only after
# server initiation (action-return). Do not add NEXT_PUBLIC_PAYPAL_CLIENT_ID
# or NEXT_PUBLIC_PAYPAL_CLIENT_SECRET.
# MODE must be sandbox | live. The project name is PAYPAL_MODE, not
# PAYPAL_ENVIRONMENT. Leave sandbox until an explicit live cutover.
# Do not set live credentials or PAYPAL_MODE=live in application code.
# WEBHOOK_ID is the Dashboard subscription id for postback signature verify.
# Required for POST /api/webhooks/paypal (never skip verify on real traffic).
# Sandbox webhook URL must be a publicly reachable HTTPS host PayPal can POST to
# (e.g. deployed preview / tunnel) — localhost alone is not enough for Dashboard delivery.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# --- Address lookup (server-only; Phase 3) ---
# SECRET. Geoapify autocomplete for supported countries other than the United Kingdom.
# Never NEXT_PUBLIC_. UK postcodes stay on Postcodes.io and do not use this key.
# If unset, international search is unavailable and the customer enters the address manually.
GEOAPIFY_API_KEY=

# --- FX cache (server-only; Phase 2) ---
# SECRET. Authenticates POST /api/internal/fx/refresh. Never NEXT_PUBLIC_.
# The daily GitHub Action sends it as Authorization: Bearer.
# That workflow also needs a repository secret FX_REFRESH_URL:
# https://<deployed-host>/api/internal/fx/refresh
# Frankfurter is called only from the server. No API key.
# FX_UPDATE_SECRET must be at least 32 random bytes (openssl rand -base64 32).
# Production ignores FRANKFURTER_BASE_URL and always calls https://api.frankfurter.dev.
# Outside production the override may be an https test host.
# FRANKFURTER_BASE_URL=
FX_UPDATE_SECRET=

# --- Razorpay (RETIRED — hard cut to PayPal; do not set for new checkouts) ---
# Historical payments.provider=razorpay rows may remain in the DB (no backfill).
# App Router webhook /api/webhooks/razorpay has been deleted (Phase 4).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Resend (server-only transactional email, PR #43–#46) ---
# SECRET. Never prefix with NEXT_PUBLIC_. Never import from a Client Component.
# Sending domain must already be verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=SHADESUK
# Optional. Verified support address. Used as the Resend reply-to and, when
# set, shown on the Contact page. Do not invent a value here.
RESEND_REPLY_TO=
# Passed as Resend `template.id`. The SDK accepts the published template id
# or the published alias. Do not invent values in application code.
# Production order-confirmation alias:
# RESEND_ORDER_CONFIRMATION_TEMPLATE_ID=order-confirmation-1
# Production shipment: paste that template's published alias or id.
RESEND_ORDER_CONFIRMATION_TEMPLATE_ID=
RESEND_SHIPMENT_CONFIRMATION_TEMPLATE_ID=
# Variables the app sends (must match the published template HTML):
# Order: ORDER_NUMBER, ORDER_DATE, TRACK_ORDER_URL, PRODUCT_NAME,
# PRODUCT_VARIANT, PRODUCT_QUANTITY, PRODUCT_PRICE, SUBTOTAL, SHIPPING, TOTAL
# Shipment: ORDER_NUMBER, SHIPMENT_DATE, TRACKING_URL, CARRIER_NAME,
# AWB_NUMBER, PRODUCT_NAME, PRODUCT_VARIANT, PRODUCT_QUANTITY, PRODUCT_PRICE
# No CID / inline product image is attached. Remove src="cid:product-image-1"
# from the published templates before launch.
# SECRET. Signing secret from the Resend webhook details page (whsec_...).
# Required by POST /api/webhooks/resend. Never NEXT_PUBLIC_.
RESEND_WEBHOOK_SECRET=
